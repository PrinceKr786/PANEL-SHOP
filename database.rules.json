{
  "rules": {
    ".read": false,
    ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",

    "admins": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      "$uid": { ".validate": "$uid === auth.uid" }
    },

    "managers": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      "$uid": {
        ".read": "$uid === auth.uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'"
      }
    },

    "users": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
      "$uid": {
        ".read": "$uid === auth.uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
        ".write": "$uid === auth.uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
        "balance": {
          ".write": "auth.uid === $uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "referralClaimable": {
          ".write": "auth.uid === $uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid) || root.child('referrals').child($uid).hasChild(auth.uid)",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid) || (auth.uid !== $uid && newData.val() <= data.val() + 10000) || (auth.uid === $uid && newData.val() <= data.val()))"
        },
        "banned": { ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'" },
        "status": {
          ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid) || auth.uid === $uid",
          ".validate": "(!data.exists() && newData.val() === 'active') || newData.val() === data.val() || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)"
        },
        "role": {
          ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || newData.val() === 'user'",
          ".validate": "newData.val().matches(/^(user|manager|admin)$/)"
        },
        "username": { ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9_-]{3,30}$/)" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "email": { ".validate": "newData.isString() && newData.val().matches(/^[^@]+@[^@]+[.][^@]+$/)" }
      }
    },

    "transactions": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
        "$txId": {
          ".validate": "newData.hasChildren(['type', 'amount', 'status', 'date', 'desc'])",
          "amount": { ".validate": "newData.isNumber() && (newData.val() > 0 || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid))" },
          "status": {
            ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid) || auth.uid === $uid",
            ".validate": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid) || newData.val().matches(/^(pending|success|failed)$/)"
          },
          "type": { ".validate": "newData.val().matches(/^(deposit_manual|deposit_auto|deposit_gateway|deposit_crypto|purchase|refund|admin_edit)$/)" }
        }
      }
    },

    "purchases": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
        "$purchaseId": {
          ".validate": "newData.hasChildren(['panelId', 'panelName', 'plan', 'label', 'price', 'key', 'date'])",
          "price": { ".validate": "newData.isNumber() && newData.val() > 0" }
        }
      }
    },

    "panels": {
      ".read": true,
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
      "$panelId": {
        ".validate": "newData.hasChildren(['name', 'description', 'category', 'plans'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 100" },
        "description": { ".validate": "newData.isString()" },
        "category": { ".validate": "newData.isString()" },
        "plans": {
          "$planKey": {
            ".validate": "newData.hasChildren(['label', 'price'])",
            "price": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "label": { ".validate": "newData.isString() && newData.val().length > 0" }
          }
        }
      }
    },

    "categories": {
      ".read": true,
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)"
    },

    "promotions": {
      ".read": true,
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'"
    },

    "coupons": {
      ".read": true,
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
      "$code": {
        ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
        "used": {
          ".write": "auth != null",
          ".validate": "newData.val() === data.val() + 1"
        }
      }
    },

    "gateway_payments": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      "$orderId": {
        ".write": "!data.exists() || auth.uid === data.child('uid').val() || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
        ".read": "auth != null",
        ".validate": "newData.hasChildren(['uid', 'amount', 'status', 'timestamp'])",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "amount": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "status": {
          ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || newData.val().matches(/^(pending|approved|failed)$/)",
          ".validate": "newData.val().matches(/^(pending|completed|approved|failed|rejected)$/)"
        }
      }
    },

    "manual_deposits": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
      "$txId": {
        ".write": "!data.exists() || auth.uid === data.child('uid').val() || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
        ".read": "auth != null",
        ".validate": "newData.hasChildren(['uid', 'amount', 'status', 'utr', 'timestamp'])",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "amount": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "utr": { ".validate": "newData.isString() && newData.val().length > 0" },
        "status": {
          ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid) || newData.val() === 'pending'",
          ".validate": "newData.val().matches(/^(pending|completed|approved|failed|rejected)$/)"
        }
      }
    },

    "crypto_deposits": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
      "$txId": {
        ".write": "!data.exists() || auth.uid === data.child('uid').val() || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
        ".read": "auth != null",
        ".validate": "newData.hasChildren(['uid', 'email', 'amount', 'status', 'timestamp'])",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "amount": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "status": {
          ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid) || newData.val() === 'pending'",
          ".validate": "newData.val().matches(/^(pending|approved|failed|rejected)$/)"
        }
      }
    },

    "settings": {
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      "branding": { ".read": true },
      "payment": { ".read": "auth != null" },
      "zap": { ".read": "auth != null" }
    },

    "payment_config": {
      ".read": "auth != null",
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'"
    },

    "zap_config": {
      ".read": "auth != null",
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'"
    },

    "deposit_settings": {
      ".read": "auth != null",
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'"
    },

    "notifications": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)"
      }
    },

    "referrals": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      "$referrerUid": {
        ".read": "$referrerUid === auth.uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
        ".write": "auth != null"
      }
    },

    "refcodes": {
      ".read": true,
      "$username": {
        ".write": "auth != null",
        ".validate": "newData.val() === auth.uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)"
      }
    },

    "hwid_resets": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "$resetId": {
          ".validate": "newData.hasChildren(['hwid', 'oldHwid', 'key', 'timestamp'])",
          "hwid": { ".validate": "newData.isString() && newData.val().length > 0" }
        }
      }
    },

    "contact_messages": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
      "$msgId": {
        ".write": "auth != null",
        ".read": false,
        ".validate": "newData.hasChildren(['name', 'email', 'message', 'timestamp'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0" },
        "email": { ".validate": "newData.isString() && newData.val().matches(/^[^@]+@[^@]+[.][^@]+$/)" },
        "message": { ".validate": "newData.isString() && newData.val().length > 0" }
      }
    },

    "branding": {
      ".read": true,
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'"
    },

    "store_config": {
      ".read": true,
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'"
    },

    "tickets": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid || auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)",
        "$ticketId": {
          ".validate": "newData.hasChildren(['subject', 'message', 'category', 'status', 'uid'])",
          "uid": { ".validate": "newData.val() === auth.uid" },
          "status": {
            ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid) || (auth.uid === $uid && newData.val() === 'open')",
            ".validate": "newData.val().matches(/^(open|closed|resolved)$/)"
          },
          "adminReply": { ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)" },
          "subject": { ".validate": "newData.isString() && newData.val().length > 0" },
          "message": { ".validate": "newData.isString() && newData.val().length > 0" }
        }
      }
    },

    "audit_log": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)"
    },

    "announcement_history": {
      ".read": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'",
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'"
    },

    "global_alerts": {
      "promotions": {
        ".read": true,
        ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2'"
      }
    },

    "support_links": {
      ".read": true,
      ".write": "auth.uid === 'rOlsx6LYYYXPYLkueN2UmviaB8O2' || root.child('managers').hasChild(auth.uid)"
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
